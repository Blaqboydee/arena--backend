# ── Arena backend environment ────────────────────────────────────────────────
# Copy to `.env` and fill in. All values are optional for local play:
# with no DATABASE_URL the server runs in "ephemeral mode" (games work,
# nothing is persisted).

# Postgres connection string (e.g. Neon — https://neon.tech).
# Enables persistent identity + match history.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Extra allowed CORS origins (comma-separated) on top of the built-in defaults.
# CORS_ALLOWED_ORIGINS="https://your-domain.com"

# Server bind (defaults: host 0.0.0.0, port 3000)
# PORT=3000
# HOST=0.0.0.0
