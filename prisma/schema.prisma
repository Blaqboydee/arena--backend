// Arena — persistence schema (Step 1: identity foundation)
//
// Design notes:
// • `User` is the durable identity. A guest is a User with `isGuest = true` and a
//   `guestToken` (minted on first connect, stored in the client's localStorage).
// • Claiming an account (Google / email magic-link, a later step) attaches an
//   `Identity` row to the same User, flips `isGuest` to false, and keeps all
//   history intact — this is the "hybrid guest + claimable account" model.
// • `Match` / `MatchParticipant` are defined now but populated in Step 2
//   (match recording). They're what leaderboards, ELO, leagues and tournaments
//   will read from.
//
// The in-match player key stays `socket.id` on the server; `User.id` is the
// *persistent* key that these tables reference.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  // Durable guest token — unique per device, null once/if you prefer to rotate.
  guestToken  String?  @unique
  displayName String   @default("Anonymous")
  avatarColor String   @default("amber")
  avatar      String   @default("") // boring-avatars seed; "" = seed off displayName
  isGuest     Boolean  @default(true)

  // Denormalized lifetime stats (incremented on each finished match) so the
  // leaderboard is a simple fast ORDER BY instead of aggregating every match.
  wins        Int @default(0)
  losses      Int @default(0) // includes forfeits
  draws       Int @default(0)
  gamesPlayed Int @default(0)
  rating      Int @default(1000) // ELO; only 1v1 competitive games move it

  // Daily Challenge streak: consecutive UTC days the player finished the daily.
  dailyStreak   Int     @default(0)
  bestStreak    Int     @default(0)
  lastDailyDate String? // "YYYY-MM-DD" of the last finished daily (UTC)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastSeenAt  DateTime @default(now())

  identities     Identity[]
  participations MatchParticipant[]
  wonMatches     Match[]            @relation("MatchWinner")
  gameStats      UserGameStat[]
  dailyResults   DailyResult[]
  soloScores     SoloScore[]

  @@index([lastSeenAt])
  @@index([wins])
  @@index([rating])
}

// One player's attempt at a given day's Daily Challenge. One row per (user, day);
// server-authoritative (the answer and per-guess grades live here), so the daily
// leaderboard is trustworthy. `guesses` is [{ word, grade[] }].
model DailyResult {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     String // "YYYY-MM-DD" (UTC)
  gameType String @default("wordle")

  answer   String
  guesses  Json    @default("[]")
  attempts Int     @default(0)
  solved   Boolean @default(false)
  finished Boolean @default(false)
  score    Int     @default(0)
  timeMs   Int     @default(0)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@unique([userId, date])
  @@index([date, score])
}

// A player's best solo score for a given game (e.g. solo Trivia). One row per
// (user, gameType), updated only when they beat their own best. Powers the solo
// high-score leaderboard.
model SoloScore {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameType String // "trivia"
  pack     String @default("random")

  score   Int @default(0)
  correct Int @default(0)
  total   Int @default(0)
  timeMs  Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userId, gameType])
  @@index([gameType, score])
}

// Per-game breakdown of a player's record (powers per-game leaderboards and the
// profile breakdown). One row per (user, gameType), upserted on each match.
model UserGameStat {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameType String

  wins   Int @default(0)
  losses Int @default(0)
  draws  Int @default(0)
  played Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userId, gameType])
  @@index([gameType, wins])
}

// External auth identities linked to a User (claimed accounts).
model Identity {
  id         String   @id @default(cuid())
  provider   String // "password" | "google" | "email" | ...
  providerId String // login handle (username, lower-cased) / external subject id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Set for provider = "password": scrypt hashes + the display-cased handle.
  // Null for external providers (Google/email) that carry no local secret.
  label        String? // username as the player typed it (for display)
  secret       String? // scrypt hash of the password
  recoveryHash String? // scrypt hash of the one-time recovery code

  createdAt DateTime @default(now())

  @@unique([provider, providerId])
  @@index([userId])
}

// One completed (or abandoned) game. Populated in Step 2.
model Match {
  id        String   @id @default(cuid())
  gameType  String
  roomId    String?
  status    String   @default("completed") // "completed" | "abandoned"
  startedAt DateTime @default(now())
  endedAt   DateTime @default(now())

  winnerId String? // User.id of winner; null = draw / no winner
  winner   User?   @relation("MatchWinner", fields: [winnerId], references: [id])

  participants MatchParticipant[]

  @@index([gameType])
  @@index([winnerId])
  @@index([endedAt])
}

// A player's slot in a match (result + score). Populated in Step 2.
model MatchParticipant {
  id      String @id @default(cuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  score       Int      @default(0)
  result      String // "win" | "loss" | "draw" | "forfeit"
  ratingDelta Int? // ELO change for this match (ranked 1v1 only)
  createdAt   DateTime @default(now())

  @@unique([matchId, userId])
  @@index([userId])
}
